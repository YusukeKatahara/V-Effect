rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────
    // 共通ヘルパー関数
    // ────────────────────────────────────────
    function isDeveloper() {
      return request.auth != null
        && get(/databases/$(database)/documents/app_config/developers)
            .data.developerUids.hasAny([request.auth.uid]);
    }

    // 他者の users ドキュメントに対して、followers/following 配列の
    // 自分自身の UID 追加・削除のみを許可するかを判定する。
    // friends キーは廃止（クライアントから他者の friends を書けない）。
    function isOnlySelfFollowDiff() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let oldFollowers = resource.data.get('followers', []);
      let newFollowers = request.resource.data.get('followers', []);
      let oldFollowing = resource.data.get('following', []);
      let newFollowing = request.resource.data.get('following', []);
      return affected.hasOnly(['followers', 'following'])
        && newFollowers.toSet().difference(oldFollowers.toSet()).hasOnly([request.auth.uid])
        && oldFollowers.toSet().difference(newFollowers.toSet()).hasOnly([request.auth.uid])
        && newFollowing.toSet().difference(oldFollowing.toSet()).hasOnly([request.auth.uid])
        && oldFollowing.toSet().difference(newFollowing.toSet()).hasOnly([request.auth.uid]);
    }

    // ────────────────────────────────────────
    // users コレクション
    // ────────────────────────────────────────
    // 自分のユーザー情報は自分だけが書き込めます。
    // フレンドのプロフィール（名前など）は認証済みユーザーなら誰でも読めます。
    // 他者からの更新は followers/following 配列の自分UID追加・削除のみ許可。
    match /users/{uid} {
      // ユーザー一覧の検索（userIdの重複チェック、フレンド検索）を許可
      allow read: if request.auth != null;

      allow write: if request.auth != null && request.auth.uid == uid;

      // ユーザー情報の更新:
      //   - 本人なら何でも
      //   - 他人なら followers/following の自分UID追加・削除のみ
      //   - 開発者ならバッジ配布などのため全て許可
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        isOnlySelfFollowDiff() ||
        isDeveloper()
      );

      // プライベート情報（email, birthDate, gender, wakeUpTime, taskTime, fcmToken）
      // 自分だけが読み書きできます
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ────────────────────────────────────────
    // friend_requests コレクション
    // ────────────────────────────────────────
    match /friend_requests/{requestId} {
      // リクエスト作成: 認証済み & fromUid が自分であること
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // リクエスト読み取り: 送信者 or 受信者のみ
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      // リクエスト更新（承認・拒否）: 受信者のみ & status のみ変更可
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // リクエスト削除（キャンセル）: 送信者のみ
      allow delete: if request.auth != null
        && resource.data.fromUid == request.auth.uid;
    }

    // ────────────────────────────────────────
    // notifications コレクション
    // ────────────────────────────────────────
    match /notifications/{notificationId} {
      // 通知作成:
      //   - 他者宛て通知: fromUid が自分自身であること（偽装防止）
      //   - 自分宛てセルフ通知（streakCelebration 等）: fromUid 未設定 & toUid が自分
      // システム通知（streakWarning, seasonTaskReceived 等）は Admin SDK
      // (Cloud Functions) 経由で作成されるためルールをバイパスする
      allow create: if request.auth != null && (
        (request.resource.data.get('fromUid', '') is string
         && request.resource.data.get('fromUid', '') == request.auth.uid)
        ||
        (!('fromUid' in request.resource.data.keys())
         && request.resource.data.toUid == request.auth.uid)
      );

      // 通知読み取り: 自分宛て or 自分が送信した通知
      allow read: if request.auth != null
        && (resource.data.toUid == request.auth.uid
            || resource.data.get('fromUid', '') == request.auth.uid);

      // 通知更新:
      //   1. 受信者（toUid==自分）による既読・処理済みマーク（isRead, isProcessed のみ）
      //   2. リアクション送信者（fromUid==自分）による、自分が送ったリアクション通知の
      //      カウント集約・上書き。連続リアクションを1通にまとめるための更新を許可する。
      //      （送信者は元々 create+delete 権限を持つため新たな権限拡大ではない。
      //        ただし toUid / fromUid の改変は禁止し、対象は reactionReceived に限定する）
      allow update: if request.auth != null && (
        (
          resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'isProcessed'])
        )
        ||
        (
          resource.data.get('fromUid', '') == request.auth.uid
          && resource.data.type == 'reactionReceived'
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.get('fromUid', '') == resource.data.get('fromUid', '')
        )
      );

      // 通知削除:
      //   - 自分宛ての通知（ユーザーが通知を消す）
      //   - 自分が送った通知（リアクション通知の集約・上書きのため）
      allow delete: if request.auth != null
        && (resource.data.toUid == request.auth.uid
            || resource.data.get('fromUid', '') == request.auth.uid);
    }

    // ────────────────────────────────────────
    // reaction_push_locks コレクション（Admin SDK 専用）
    // リアクション通知プッシュのデバウンス制御に使う。クライアントから
    // 触れないようにすることで、アプリ版に関わらず集約（連続リアクション→1通）を保つ。
    // ────────────────────────────────────────
    match /reaction_push_locks/{notificationId} {
      allow read, write: if false;
    }

    // ────────────────────────────────────────
    // reports コレクション
    // ────────────────────────────────────────
    // クライアントからの直接 create は禁止。reportUser/reportPost Cloud Functions
    // 経由で作成すること（レート制限・重複チェック・実在検証を Function 側で実施）。
    match /reports/{reportId} {
      allow create: if false;

      // 通報読み取り: 自分が送った通報のみ（重複チェック等の互換のため残す）
      allow read: if request.auth != null
        && resource.data.reporterUid == request.auth.uid;
    }

    // ────────────────────────────────────────
    // contactInquiries コレクション
    // ────────────────────────────────────────
    match /contactInquiries/{docId} {
      // サポートページは未ログインでもアクセス可のため、未認証でも作成を許可
      // category は許容リストに限定、email/category にメールヘッダー改行不可
      allow create:
        if request.resource.data.keys().hasAll(['email', 'category', 'message', 'createdAt'])
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.category in [
            'bug', 'feature', 'account', 'other',
            'バグ報告', '機能要望', 'アカウント', 'その他'
          ]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 256
        && !request.resource.data.email.matches('.*[\r\n].*');
      // 管理者以外は読み取り・更新・削除不可
      allow read, update, delete: if false;
    }

    // ────────────────────────────────────────
    // loginAttempts コレクション（Admin SDK 専用）
    // loginWithUserId Cloud Function が連続失敗回数とブロック解除時刻を記録する。
    // クライアントから読み書きできるとロック回避が可能になるため一切拒否。
    // ────────────────────────────────────────
    match /loginAttempts/{uid} {
      allow read, write: if false;
    }

    // ────────────────────────────────────────
    // analytics コレクション（Admin SDK 専用）
    // Flutter アプリからは一切アクセス不可
    // ────────────────────────────────────────
    match /analytics_users/{userId} {
      allow read, write: if false;
      match /posts/{postId} { allow read, write: if false; }
      match /streaks/{entryId} { allow read, write: if false; }
      match /tasks/{entryId} { allow read, write: if false; }
    }
    match /analytics_app_state/{docId} {
      allow read, write: if false;
    }

    // ────────────────────────────────────────
    // dev_blog コレクション（V-Practice ブログ）
    // 開発者判定は Auth UID ベース（userId 経由は廃止）
    // ────────────────────────────────────────
    match /dev_blog/{postId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isDeveloper();
    }

    // ────────────────────────────────────────
    // seasons コレクション
    // ────────────────────────────────────────
    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isDeveloper();
    }

    // ────────────────────────────────────────
    // app_config（開発者UID管理など）
    // ────────────────────────────────────────
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ────────────────────────────────────────
    // global_stats コレクション
    // ────────────────────────────────────────
    match /global_stats/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ────────────────────────────────────────
    // posts コレクション
    // ────────────────────────────────────────
    match /posts/{postId} {
      // 【仕様】ログインしているユーザーが自分の投稿を作れる
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // 【仕様】自分の投稿は自分だけが更新・削除できる（リアクションは除外 → reactionCount は別途許可）
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // 【仕様】reactionCount の更新は誰でも（ログインユーザーなら）OK
      // ただし reactionCount 以外のフィールドを変更しようとしてもブロックします
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount', 'emojiReactedUserIds', 'userReactions']);

      // 【仕様】(Vuln-2 対応の修正)
      // Firestoreのクエリ制約を満たすため、また getAllMyPastPosts 等の全取得クエリに対応するため以下のように修正:
      //   1. 本人の投稿: 常に閲覧可能（アプリ内の機能で全期間の履歴が必要なため）
      //   2. 他人の投稿: フォロー関係にあり、かつ expiresAt の条件を満たすもの。
      //      ※ クライアントの時計のズレ（now < request.time）による permission-denied を防ぐため、
      //        サーバー側の評価には1時間のバッファ (request.time - 1h) を設ける。
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid
        ||
        (
          resource.data.expiresAt > request.time - duration.value(1, 'h')
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('following', []).hasAny([resource.data.userId])
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('friends', []).hasAny([resource.data.userId])
          )
        )
      );
    }

    // ────────────────────────────────────────
    // action_logs コレクション（行動ログ：書き込み専用）
    // ────────────────────────────────────────
    // ローカルバッチ型アナリティクス基盤。本人の uid を持つドキュメントの
    // 作成のみ許可し、読取・更新・削除はクライアントから一切不可。
    // 分析は BigQuery Export / Admin SDK 経由で行う。
    match /action_logs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}

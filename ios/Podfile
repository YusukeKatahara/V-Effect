# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  # FirebaseFirestoreInternalが依存するnanopbのヘッダーが見つからないエラーを回避するため、明示的に指定します
  pod 'nanopb', :modular_headers => true

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Remove hardcoded CODE_SIGNING_REQUIRED=NO as it prevents physical device builds and push notifications
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end

  installer.pods_project.build_configurations.each do |config|
    config.build_settings["ONLY_ACTIVE_ARCH"] = "YES"
  end

  # メインプロジェクト（Runner.xcodeproj）のバリデーションと修復のガードレール
  main_project_path = File.join(Dir.pwd, 'Runner.xcodeproj')
  if File.exist?(main_project_path)
    require 'xcodeproj'
    project = Xcodeproj::Project.open(main_project_path)
    changed = false
    project.targets.each do |target|
      target.build_configurations.each do |config|
        target_version = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if target_version && target_version.to_f > 30.0
          puts "\n[Guardrail] ⚠️ 警告: ターゲット '#{target.name}' (#{config.name}) の IPHONEOS_DEPLOYMENT_TARGET が異常値 '#{target_version}' になっています。'26.2' に自動修復します。"
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '26.2'
          changed = true
        end
      end
    end

    # Tools バージョンや Swift バージョンチェックの異常値も修復
    if project.root_object.attributes['TargetAttributes']
      project.root_object.attributes['TargetAttributes'].each do |target_id, attrs|
        created_tools_version = attrs['CreatedOnToolsVersion']
        if created_tools_version && created_tools_version.to_f > 30.0
          puts "\n[Guardrail] ⚠️ 警告: TargetAttributes 内の CreatedOnToolsVersion が異常値 '#{created_tools_version}' になっています。'26.3' に自動修復します。"
          attrs['CreatedOnToolsVersion'] = '26.3'
          changed = true
        end
      end
    end

    last_swift_update = project.root_object.attributes['LastSwiftUpdateCheck']
    if last_swift_update && last_swift_update.to_f > 3000.0
      puts "\n[Guardrail] ⚠️ 警告: LastSwiftUpdateCheck が異常値 '#{last_swift_update}' になっています。'2630' に自動修復します。"
      project.root_object.attributes['LastSwiftUpdateCheck'] = '2630'
      changed = true
    end

    if changed
      project.save
      puts "[Guardrail] ✅ Runner.xcodeproj の修復が完了しました。\n"
    end
  end
end

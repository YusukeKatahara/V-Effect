                <constraint firstItem="gradientView" firstAttribute="leading" secondItem="iN0-l3-epB" secondAttribute="leading" id="g1"/>
                <constraint firstItem="gradientView" firstAttribute="trailing" secondItem="iN0-l3-epB" secondAttribute="trailing" id="g2"/>
                <constraint firstItem="gradientView" firstAttribute="bottom" secondItem="iN0-l3-epB" secondAttribute="bottom" id="g3"/>
                
                <!-- Bottom Container Constraints -->
                <constraint firstItem="bottomContainer" firstAttribute="leading" secondItem="iN0-l3-epB" secondAttribute="leading" constant="20" id="bc1"/>
                <constraint firstItem="bottomContainer" firstAttribute="trailing" secondItem="iN0-l3-epB" secondAttribute="trailing" constant="-20" id="bc2"/>
                <constraint firstItem="bottomContainer" firstAttribute="bottom" secondItem="iN0-l3-epB" secondAttribute="bottom" constant="-32" id="bc3"/>
                

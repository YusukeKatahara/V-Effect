                <constraint firstAttribute="trailing" secondItem="muteButton" secondAttribute="trailing" constant="16" id="mu1"/>
                <constraint firstItem="muteButton" firstAttribute="top" secondItem="iN0-l3-epB" secondAttribute="top" constant="16" id="mu2"/>
            </constraints>
            <nil key="simulatedTopBarMetrics"/>
            <nil key="simulatedBottomBarMetrics"/>
            <freeformSimulatedSizeMetrics key="simulatedDestinationMetrics"/>
            <connections>
                <outlet property="customMediaView" destination="mediaView" id="ol1"/>
                <outlet property="customHeadlineLabel" destination="headlineLabel" id="ol2"/>
                <outlet property="customBodyLabel" destination="bodyLabel" id="ol3"/>

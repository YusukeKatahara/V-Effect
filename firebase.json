{
  "remoteconfig": { "template": "remote_config.json" },
  "functions": { "source": "functions" },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "hosting": [
    {
      "target": "lp",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [{ "key": "Content-Type", "value": "application/json" }]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [{ "key": "Content-Type", "value": "application/json" }]
        }
      ]
    },
    {
      "target": "app",
      "public": "build/web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|main.dart.js|version.json)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "veffect",
          "appId": "1:785257044471:android:ef89f2dfda60208974b6f2",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "veffect",
          "configurations": {
            "android": "1:785257044471:android:ef89f2dfda60208974b6f2",
            "ios": "1:785257044471:ios:6699feb7d404bdad74b6f2",
            "macos": "1:785257044471:ios:6699feb7d404bdad74b6f2",
            "web": "1:785257044471:web:3bab25843b355b6674b6f2"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "veffect",
          "appId": "1:785257044471:ios:6699feb7d404bdad74b6f2",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "veffect",
          "appId": "1:785257044471:ios:6699feb7d404bdad74b6f2",
          "uploadDebugSymbols": true,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      }
    }
  }
}
